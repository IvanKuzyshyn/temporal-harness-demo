# INTERNAL manual entrypoints only. Public mise setup/up/down generates and
# preserves private <WEBCHAT_HOME>/config.json instead of sourcing .env.
# For a manually managed stack, replace every placeholder
# with independent random values (e.g. openssl rand -hex 32). Never deploy these
# placeholders. Existing database volumes keep their originally initialized passwords.
COMPOSE_PROJECT_NAME=webchat-local
WEBCHAT_POSTGRES_PORT=15432
WEBCHAT_TEMPORAL_PORT=17233
WEBCHAT_TEMPORAL_UI_PORT=18080
WEBCHAT_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
WEBCHAT_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
WEBCHAT_TEMPORAL_DB_PASSWORD=REPLACE_WITH_RANDOM_TEMPORAL_PASSWORD
# Use the SAME app password as WEBCHAT_DB_PASSWORD; URL-encode non-hex passwords.
WEBCHAT_DATABASE_URL=postgres://webchat:REPLACE_WITH_RANDOM_APP_PASSWORD@127.0.0.1:15432/webchat?sslmode=disable
WEBCHAT_API_LISTEN=127.0.0.1:18081
WEBCHAT_BROWSER_ORIGIN=http://localhost:13000
# Next.js server only; must match WEBCHAT_API_LISTEN (never NEXT_PUBLIC_*).
WEBCHAT_API_URL=http://127.0.0.1:18081
# Server-side only: never NEXT_PUBLIC_ or forwarded to the browser.
WEBCHAT_PROXY_SECRET=REPLACE_WITH_64_LOWERCASE_RANDOM_HEX_CHARACTERS
WEBCHAT_TEMPORAL_ADDRESS=127.0.0.1:17233
WEBCHAT_OLLAMA_URL=http://127.0.0.1:11434
# Host API AND worker must use the same persistent absolute directory.
WEBCHAT_ATTACHMENT_ROOT=/REPLACE/WITH/ABSOLUTE/PERSISTENT/attachments
