# Task 1 isolated development infrastructure; not the final mise lifecycle.
# Copy to .env without overwriting an existing file. Local demo credentials only.
COMPOSE_PROJECT_NAME=webchat-local
WEBCHAT_POSTGRES_PORT=15432
WEBCHAT_TEMPORAL_PORT=17233
WEBCHAT_TEMPORAL_UI_PORT=18080
WEBCHAT_POSTGRES_PASSWORD=local-admin-only
WEBCHAT_DB_PASSWORD=local-webchat-only
WEBCHAT_TEMPORAL_DB_PASSWORD=local-temporal-only
# Reserved for subsequent API/worker tasks; legacy env variables remain unchanged.
WEBCHAT_DATABASE_URL=postgres://webchat:local-webchat-only@127.0.0.1:15432/webchat?sslmode=disable
WEBCHAT_TEMPORAL_ADDRESS=127.0.0.1:17233
WEBCHAT_OLLAMA_URL=http://127.0.0.1:11434
